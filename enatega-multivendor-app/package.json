{
  "name": "enatega-full-app",
  "version": "5.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "eject": "expo eject",
    "format": "prettier --write '**/*.js'",
    "lint:fix": "eslint . --ext .js --fix",
    "check:single-vendor-imports": "node scripts/check-single-vendor-imports.js",
    "check:single-vendor-schema": "node scripts/check-single-vendor-schema.js",
    "check:order-pricing": "node scripts/check-order-pricing.js",
    "check:ios-privacy": "node scripts/check-ios-privacy.js",
    "check:multivendor-design": "node scripts/check-multivendor-design.js",
    "update:multivendor-design-baseline": "node scripts/check-multivendor-design.js --update-baseline",
    "postinstall": "patch-package",
    "eas-build-post-install": "npm run check:ios-privacy",
    "build:staging": "eas build --profile staging -p all",
    "build:staging:android": "eas build --profile staging -p android",
    "build:staging:ios": "eas build --profile staging -p ios",
    "build:development": "eas build --profile development -p all",
    "build:development:android": "eas build --profile development -p android",
    "build:development:ios": "eas build --profile development -p ios",
    "build:production": "npm run check:ios-privacy && eas build --profile production -p all --clear-cache",
    "build:production:android": "eas build --profile production -p android",
    "build:production:ios": "npm run check:ios-privacy && eas build --profile production -p ios --clear-cache",
    "submit:production": "eas submit --profile production -p all",
    "submit:production:android": "eas submit --profile production -p android",
    "submit:production:ios": "eas submit --profile production -p ios",
    "publish:staging": "ENVIRONMENT=staging expo publish --release-channel staging",
    "publish:production": "ENVIRONMENT=production expo publish --release-channel production",
    "apkBuild": "eas build --profile staging --platform android",
    "iosTestFlight": "npm run check:ios-privacy && eas build --profile production --platform ios --clear-cache"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "npm run format",
      "npm run lint:fix"
    ]
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.4.7",
    "@apollo/client": "^3.5.6",
    "@babel/plugin-transform-object-rest-spread": "^7.23.4",
    "@babel/plugin-transform-optional-catch-binding": "^7.23.4",
    "@bacons/apple-targets": "^3.0.2",
    "@expo/vector-icons": "^15.0.2",
    "@lottiefiles/dotlottie-react": "^0.20.0",
    "@microsoft/react-native-clarity": "^4.3.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-native-google-signin/google-signin": "^12.2.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/elements": "^1.2.1",
    "@react-navigation/native": "^6.0.6",
    "@react-navigation/stack": "^6.0.11",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@stripe/stripe-react-native": "0.64.0",
    "@twotalltotems/react-native-otp-input": "^1.3.11",
    "@types/react": "~19.2.4",
    "activity-controller": "git+https://github.com/enatega/activity-controller.git#72b42897aa97ce4e000ecec95d610efa46f54979",
    "axios": "^1.6.8",
    "core-js": "^3.33.3",
    "deprecated-react-native-prop-types": "^5.0.0",
    "eas-build-cache-provider": "^16.4.2",
    "expo": "~57.0.0",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-auth-session": "~57.0.16",
    "expo-build-properties": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
